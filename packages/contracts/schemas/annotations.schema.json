{
  "$ref": "#/definitions/annotations",
  "definitions": {
    "annotations": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1"
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "image_width": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "image_height": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "source": {
          "type": "string",
          "enum": [
            "codex",
            "human"
          ]
        },
        "preview_reviewed": {
          "type": "boolean"
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "region_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,100}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "text",
                  "component",
                  "image"
                ]
              },
              "boundary": {
                "type": "string",
                "enum": [
                  "element_box",
                  "content_only"
                ]
              },
              "bbox": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "expected_text": {
                "type": "string"
              }
            },
            "required": [
              "region_id",
              "kind",
              "boundary"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "version",
        "image_sha256",
        "image_width",
        "image_height",
        "source",
        "preview_reviewed",
        "unresolved",
        "regions"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
