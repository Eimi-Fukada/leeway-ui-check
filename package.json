{
  "name": "leeway-ui-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build apps/report-web --outDir ../../dist/report-web",
    "cli": "tsx packages/cli/src/index.ts",
    "mcp": "tsx packages/mcp/src/index.ts",
    "worker": "tsx packages/cli/src/index.ts worker",
    "demo": "tsx scripts/demo.ts",
    "schemas": "tsx scripts/schemas.ts",
    "setup:browser": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.17.4",
    "better-sqlite3": "12.2.0",
    "pixelmatch": "7.1.0",
    "playwright": "1.55.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.34.3",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.17.2",
    "@types/pixelmatch": "5.2.6",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.4",
    "vitest": "3.2.4"
  }
}
